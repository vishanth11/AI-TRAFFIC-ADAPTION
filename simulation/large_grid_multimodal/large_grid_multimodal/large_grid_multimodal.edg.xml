<!-- Edges for the multimodal 4x4 urban grid.

     Road edges are identical to the validated large_grid scenario
     (2 lanes per direction, 40 km/h = 11.11 m/s), EXCEPT the eight
     horizontal edges that are crossed by the rail line (rows y=900,
     600, 300, 0, both directions). Those are split into three parts
     each so that the rail_crossing nodes (rw_rc*/re_rc*) sit between
     real edges:
       _p1 / _p2 / _p3   first / middle / last part in driving direction
     Sidewalks, pedestrian crossings and bike lanes are NOT defined
     here; build_network.py generates them with netconvert using the
     guessing options "sidewalks.guess", "crossings.guess" and
     "bikelanes.guess".

     Rail edges (1 lane, 72 km/h = 20 m/s, rail-only) form two
     one-directional tracks through the crossing nodes. -->
<edges>
    <!-- Row 1 (northern row): J01 - J02 - J03 - J04
         J01_J02 / J02_J01 are split by both rail tracks. -->
    <edge id="J01_J02_p1" from="J01" to="rw_rc900" numLanes="2" speed="11.11"/>
    <edge id="J01_J02_p2" from="rw_rc900" to="re_rc900" numLanes="2" speed="11.11"/>
    <edge id="J01_J02_p3" from="re_rc900" to="J02" numLanes="2" speed="11.11"/>
    <edge id="J02_J01_p1" from="J02" to="re_rc900" numLanes="2" speed="11.11"/>
