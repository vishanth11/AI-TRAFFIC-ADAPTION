<routes>
    <!-- Normal vehicles: plain yellow -->
    <vType
        id="car"
        vClass="passenger"
        guiShape="passenger"
        accel="2.6"
        decel="4.5"
        sigma="0.5"
        length="5"
        width="1.8"
        minGap="2.5"
        maxSpeed="13.9"
        color="1,1,0"
    />

    <!--
        Emergency vehicle:
        - Starts early so it is clearly visible in the GUI demo.
        - vClass=emergency preserves emergency behavior.
        - guiShape=emergency gives the SUMO emergency vehicle icon.
        - has.bluelight.device enables the blue emergency light.
        - Larger dimensions make it easy to distinguish from normal cars.
    -->
    <vType
        id="ambulance"
        vClass="emergency"
        guiShape="emergency"
        accel="3.0"
        decel="5.0"
        sigma="0.0"
        length="10"
        width="3"
        minGap="2.5"
        maxSpeed="13.9"
        color="1,1,0"
    >
        <param key="has.bluelight.device" value="true" />
    </vType>

    <route id="eastbound" edges="left0A0 A0B0 B0C0 C0right0" />
    <route id="westbound" edges="right0C0 C0B0 B0A0 A0left0" />

    <!-- Normal background traffic -->
    <flow
        id="eastbound_flow"
        type="car"
        route="eastbound"
        begin="0"
        end="900"
        vehsPerHour="900"
    />
    <flow
        id="westbound_flow"
        type="car"
        route="westbound"
        begin="0"
        end="900"
        vehsPerHour="900"
    />

    <!-- Exactly ONE clearly visible emergency vehicle -->
    <vehicle
        id="ambulance_0"
        type="ambulance"
        route="eastbound"
        depart="5"
        departLane="0"
        departSpeed="13.9"
    />
</routes>
