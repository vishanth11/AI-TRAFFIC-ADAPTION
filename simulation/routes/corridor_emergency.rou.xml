<routes>
    <!-- Normal traffic -->
    <vType id="car" vClass="passenger" guiShape="passenger" accel="2.6" decel="4.5" sigma="0.5" length="5" width="1.8" minGap="2.5" maxSpeed="13.9" color="1,1,0" />

    <!-- Emergency vehicle: no blue-light device; AI controls safe preemption. -->
    <vType id="ambulance" vClass="emergency" guiShape="emergency" accel="3.0" decel="5.0" sigma="0.0" length="10" width="3" minGap="2.5" maxSpeed="13.9" jmDriveAfterRedTime="0" jmDriveAfterYellowTime="0" color="1,1,0" />

    <!-- Normal routes -->
    <route id="left_to_right" edges="left0A0 A0B0 B0C0 C0right0" />
    <route id="right_to_left" edges="right0C0 C0B0 B0A0 A0left0" />
    <route id="top0_to_top1" edges="top0A0 A0B0 B0top1" />
    <route id="bottom0_to_bottom1" edges="bottom0A0 A0B0 B0bottom1" />
    <route id="top1_to_top2" edges="top1B0 B0C0 C0top2" />
    <route id="bottom1_to_bottom2" edges="bottom1B0 B0C0 C0bottom2" />
    <route id="top2_to_bottom0" edges="top2C0 C0B0 B0A0 A0bottom0" />
    <route id="bottom2_to_top0" edges="bottom2C0 C0B0 B0A0 A0top0" />
    <route id="top2_to_bottom2" edges="top2C0 C0bottom2" />

    <!-- Turning routes -->
    <route id="top0_to_left" edges="top0A0 A0left0" />
    <route id="top0_to_bottom" edges="top0A0 A0bottom0" />
    <route id="bottom0_to_left" edges="bottom0A0 A0left0" />
    <route id="bottom0_to_top" edges="bottom0A0 A0top0" />
    <route id="top1_to_left" edges="top1B0 B0A0 A0left0" />
    <route id="bottom1_to_right" edges="bottom1B0 B0C0 C0right0" />
    <route id="top2_to_right" edges="top2C0 C0right0" />
    <route id="bottom2_to_left" edges="bottom2C0 C0B0 B0A0 A0left0" />

    <!-- ================================================================ -->
    <!-- TWO AMBULANCES AT THE SAME SIGNAL: B0                       -->
    <!-- ================================================================ -->
    <!--
        Both vehicles depart at EXACTLY the same simulation time (20 s).
        Both are placed directly on the two incoming B0 approaches so they
        visibly reach B0 together instead of being separated by long routes.

        ambulance_0: A0 -> B0 -> C0 -> NORTH
        ambulance_1: NORTH -> B0 -> SOUTH

        They therefore meet at B0 and request conflicting movements.
        Normal traffic continues simultaneously, forcing the AI to balance
        emergency priority against regular demand while respecting conflicts.
    -->

    <!-- Ambulance 0: A0 -> B0 -> C0 -> NORTH -->
    <route id="ambulance_0_a0_b0_c0_north" edges="A0B0 B0C0 C0top2" />
    <vehicle
        id="ambulance_0"
        type="ambulance"
        route="ambulance_0_a0_b0_c0_north"
        depart="20"
        departLane="0"
        departSpeed="13.9"
    />

    <!-- Ambulance 1: NORTH -> B0 -> SOUTH -->
    <route id="ambulance_1_b0_north_to_south" edges="top1B0 B0bottom1" />
    <vehicle
        id="ambulance_1"
        type="ambulance"
        route="ambulance_1_b0_north_to_south"
        depart="20"
        departLane="0"
        departSpeed="13.9"
    />

    <!-- ================================================================ -->
    <!-- LATER SEPARATE EMERGENCIES                                    -->
    <!-- ================================================================ -->

    <!-- Ambulance 2: EAST -> A0 -> NORTH -->
    <route id="ambulance_2_a0_east_to_north" edges="B0A0 A0top0" />
    <vehicle
        id="ambulance_2"
        type="ambulance"
        route="ambulance_2_a0_east_to_north"
        depart="120"
        departLane="0"
        departSpeed="13.9"
    />

    <!-- Ambulance 3: NORTH C0 -> B0 -> A0 -> SOUTH -->
    <route id="ambulance_3_c0_north_to_a0_south" edges="top2C0 C0B0 B0A0 A0bottom0" />
    <vehicle
        id="ambulance_3"
        type="ambulance"
        route="ambulance_3_c0_north_to_a0_south"
        depart="200"
        departLane="0"
        departSpeed="13.9"
    />

    <!-- ================================================================ -->
    <!-- NORMAL TRAFFIC                                                 -->
    <!-- ================================================================ -->
    <flow id="flow_left_to_right" type="car" route="left_to_right" begin="0" end="900" vehsPerHour="400" />
    <flow id="flow_right_to_left" type="car" route="right_to_left" begin="0" end="900" vehsPerHour="400" />
    <flow id="flow_top0_to_top1" type="car" route="top0_to_top1" begin="0" end="900" vehsPerHour="350" />
    <flow id="flow_bottom0_to_bottom1" type="car" route="bottom0_to_bottom1" begin="0" end="900" vehsPerHour="350" />
    <flow id="flow_top1_to_top2" type="car" route="top1_to_top2" begin="0" end="900" vehsPerHour="350" />
    <flow id="flow_bottom1_to_bottom2" type="car" route="bottom1_to_bottom2" begin="0" end="900" vehsPerHour="350" />
    <flow id="flow_top2_to_bottom0" type="car" route="top2_to_bottom0" begin="0" end="900" vehsPerHour="350" />
    <flow id="flow_bottom2_to_top0" type="car" route="bottom2_to_top0" begin="0" end="900" vehsPerHour="350" />
    <flow id="flow_top2_to_bottom2" type="car" route="top2_to_bottom2" begin="0" end="900" vehsPerHour="250" />

    <!-- Additional turning traffic around all three junctions -->
    <flow id="flow_top0_to_left" type="car" route="top0_to_left" begin="0" end="900" vehsPerHour="200" />
    <flow id="flow_top0_to_bottom" type="car" route="top0_to_bottom" begin="0" end="900" vehsPerHour="200" />
    <flow id="flow_bottom0_to_left" type="car" route="bottom0_to_left" begin="0" end="900" vehsPerHour="200" />
    <flow id="flow_bottom0_to_top" type="car" route="bottom0_to_top" begin="0" end="900" vehsPerHour="200" />
    <flow id="flow_top1_to_left" type="car" route="top1_to_left" begin="0" end="900" vehsPerHour="200" />
    <flow id="flow_bottom1_to_right" type="car" route="bottom1_to_right" begin="0" end="900" vehsPerHour="200" />
    <flow id="flow_top2_to_right" type="car" route="top2_to_right" begin="0" end="900" vehsPerHour="200" />
    <flow id="flow_bottom2_to_left" type="car" begin="0" end="900" vehsPerHour="200" route="bottom2_to_left" />
</routes>
