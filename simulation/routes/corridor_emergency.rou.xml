<routes>
    <!-- Normal traffic: yellow vehicles -->
    <vType
        id="car"
        vClass="passenger"
        guiShape="passenger"
        accel="2.6"
        decel="4.5"
        sigma="0.5"
        length="5"
        width="1.8"
        minGap="2.5"
        maxSpeed="13.9"
        color="1,1,0"
    />

    <!--
        Emergency vehicle.
        No SUMO blue-light device is attached.
        The ambulance therefore cannot use SUMO's automatic red-light bypass.
        The AI controller must select a safe green phase before it proceeds.
        The explicit junction parameters below also forbid red/yellow violation.
    -->
    <vType
        id="ambulance"
        vClass="emergency"
        guiShape="emergency"
        accel="3.0"
        decel="5.0"
        sigma="0.0"
        length="10"
        width="3"
        minGap="2.5"
        maxSpeed="13.9"
        color="1,1,0"
        jmDriveAfterRedTime="0"
        jmDriveAfterYellowTime="0"
    />

    <!-- Cross-corridor demand -->
    <route id="left_to_right" edges="left0A0 A0B0 B0C0 C0right0" />
    <route id="right_to_left" edges="right0C0 C0B0 B0A0 A0left0" />
    <route id="top0_to_top1" edges="top0A0 A0B0 B0top1" />
    <route id="bottom0_to_bottom1" edges="bottom0A0 A0B0 B0bottom1" />
    <route id="top1_to_top2" edges="top1B0 B0C0 C0top2" />
    <route id="bottom1_to_bottom2" edges="bottom1B0 B0C0 C0bottom2" />
    <route id="top2_to_bottom0" edges="top2C0 C0B0 B0A0 A0bottom0" />
    <route id="bottom2_to_top0" edges="bottom2C0 C0B0 B0A0 A0top0" />
    <route id="top2_to_bottom2" edges="top2C0 C0bottom2" />

    <!-- Turning/local demand to create conflicts at all junctions -->
    <route id="top0_to_left" edges="top0A0 A0left0" />
    <route id="top0_to_bottom" edges="top0A0 A0bottom0" />
    <route id="bottom0_to_left" edges="bottom0A0 A0left0" />
    <route id="bottom0_to_top" edges="bottom0A0 A0top0" />
    <route id="top1_to_left" edges="top1B0 B0A0 A0left0" />
    <route id="bottom1_to_right" edges="bottom1B0 B0C0 C0right0" />
    <route id="top2_to_right" edges="top2C0 C0right0" />
    <route id="bottom2_to_left" edges="bottom2C0 C0B0 B0A0 A0left0" />

    <!-- Exactly ONE ambulance; kept before all flows for sorted departure loading. -->
    <vehicle
        id="ambulance_0"
        type="ambulance"
        route="left_to_right"
        depart="0"
        departLane="0"
        departSpeed="13.9"
    />

    <!-- Main demand -->
    <flow id="flow_left_to_right" type="car" route="left_to_right" begin="0" end="900" vehsPerHour="300" />
    <flow id="flow_right_to_left" type="car" route="right_to_left" begin="0" end="900" vehsPerHour="300" />
    <flow id="flow_top0_to_top1" type="car" route="top0_to_top1" begin="0" end="900" vehsPerHour="300" />
    <flow id="flow_bottom0_to_bottom1" type="car" route="bottom0_to_bottom1" begin="0" end="900" vehsPerHour="300" />
    <flow id="flow_top1_to_top2" type="car" route="top1_to_top2" begin="0" end="900" vehsPerHour="300" />
    <flow id="flow_bottom1_to_bottom2" type="car" route="bottom1_to_bottom2" begin="0" end="900" vehsPerHour="300" />
    <flow id="flow_top2_to_bottom0" type="car" route="top2_to_bottom0" begin="0" end="900" vehsPerHour="300" />
    <flow id="flow_bottom2_to_top0" type="car" route="bottom2_to_top0" begin="0" end="900" vehsPerHour="300" />
    <flow id="flow_top2_to_bottom2" type="car" route="top2_to_bottom2" begin="0" end="900" vehsPerHour="300" />

    <!-- Additional turning demand -->
    <flow id="flow_top0_to_left" type="car" route="top0_to_left" begin="0" end="900" vehsPerHour="150" />
    <flow id="flow_top0_to_bottom" type="car" route="top0_to_bottom" begin="0" end="900" vehsPerHour="150" />
    <flow id="flow_bottom0_to_left" type="car" route="bottom0_to_left" begin="0" end="900" vehsPerHour="150" />
    <flow id="flow_bottom0_to_top" type="car" route="bottom0_to_top" begin="0" end="900" vehsPerHour="150" />
    <flow id="flow_top1_to_left" type="car" route="top1_to_left" begin="0" end="900" vehsPerHour="150" />
    <flow id="flow_bottom1_to_right" type="car" route="bottom1_to_right" begin="0" end="900" vehsPerHour="150" />
    <flow id="flow_top2_to_right" type="car" route="top2_to_right" begin="0" end="900" vehsPerHour="150" />
    <flow id="flow_bottom2_to_left" type="car" route="bottom2_to_left" begin="0" end="900" vehsPerHour="150" />
</routes>
