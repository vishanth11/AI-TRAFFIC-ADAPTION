<routes>
    <vType id="car" vClass="passenger" guiShape="passenger" accel="2.6" decel="4.5" sigma="0.5" length="5" width="1.8" minGap="2.5" maxSpeed="13.9" color="1,1,0" />
    <vType id="ambulance" vClass="emergency" guiShape="emergency" accel="3.0" decel="5.0" sigma="0.0" length="10" width="3" minGap="2.5" maxSpeed="13.9" jmDriveAfterRedTime="0" jmDriveAfterYellowTime="0" color="1,1,0" />

    <route id="left_to_right" edges="left0A0 A0B0 B0C0 C0right0" />
    <route id="right_to_left" edges="right0C0 C0B0 B0A0 A0left0" />
    <route id="top0_to_top1" edges="top0A0 A0B0 B0top1" />
    <route id="bottom0_to_bottom1" edges="bottom0A0 A0B0 B0bottom1" />
    <route id="top1_to_top2" edges="top1B0 B0C0 C0top2" />
    <route id="bottom1_to_bottom2" edges="bottom1B0 B0C0 C0bottom2" />
    <route id="top2_to_bottom0" edges="top2C0 C0B0 B0A0 A0bottom0" />
    <route id="bottom2_to_top0" edges="bottom2C0 C0B0 B0A0 A0top0" />
    <route id="top2_to_bottom2" edges="top2C0 C0bottom2" />

    <route id="top0_to_left" edges="top0A0 A0left0" />
    <route id="top0_to_bottom" edges="top0A0 A0bottom0" />
    <route id="bottom0_to_left" edges="bottom0A0 A0left0" />
    <route id="bottom0_to_top" edges="bottom0A0 A0top0" />
    <route id="top1_to_left" edges="top1B0 B0A0 A0left0" />
    <route id="bottom1_to_right" edges="bottom1B0 B0C0 C0right0" />
    <route id="top2_to_right" edges="top2C0 C0right0" />
    <route id="bottom2_to_left" edges="bottom2C0 C0B0 B0A0 A0left0" />

    <!--
        SIMULTANEOUS B0 EMERGENCY TEST
        Both ambulances depart at exactly 20 s and approach B0 from
        conflicting directions. Normal traffic is intentionally heavy.

        ambulance_0: A0 -> B0 -> C0 -> NORTH
        ambulance_1: NORTH -> B0 -> SOUTH
    -->
    <route id="ambulance_0_b0_to_north" edges="A0B0 B0C0 C0top2" />
    <vehicle id="ambulance_0" type="ambulance" route="ambulance_0_b0_to_north" depart="20" departLane="0" departSpeed="13.9" />

    <route id="ambulance_1_b0_north_to_south" edges="top1B0 B0bottom1" />
    <vehicle id="ambulance_1" type="ambulance" route="ambulance_1_b0_north_to_south" depart="20" departLane="0" departSpeed="13.9" />

    <!-- Later emergency events, separated from the simultaneous B0 test. -->
    <route id="ambulance_2_a0_east_to_north" edges="B0A0 A0top0" />
    <vehicle id="ambulance_2" type="ambulance" route="ambulance_2_a0_east_to_north" depart="110" departLane="0" departSpeed="13.9" />

    <route id="ambulance_3_c0_north_to_a0_south" edges="top2C0 C0B0 B0A0 A0bottom0" />
    <vehicle id="ambulance_3" type="ambulance" route="ambulance_3_c0_north_to_a0_south" depart="190" departLane="0" departSpeed="13.9" />

    <!-- HEAVY NORMAL TRAFFIC -->
    <flow id="flow_left_to_right" type="car" route="left_to_right" begin="0" end="900" vehsPerHour="600" />
    <flow id="flow_right_to_left" type="car" route="right_to_left" begin="0" end="900" vehsPerHour="600" />
    <flow id="flow_top0_to_top1" type="car" route="top0_to_top1" begin="0" end="900" vehsPerHour="500" />
    <flow id="flow_bottom0_to_bottom1" type="car" route="bottom0_to_bottom1" begin="0" end="900" vehsPerHour="500" />
    <flow id="flow_top1_to_top2" type="car" route="top1_to_top2" begin="0" end="900" vehsPerHour="500" />
    <flow id="flow_bottom1_to_bottom2" type="car" route="bottom1_to_bottom2" begin="0" end="900" vehsPerHour="500" />
    <flow id="flow_top2_to_bottom0" type="car" route="top2_to_bottom0" begin="0" end="900" vehsPerHour="500" />
    <flow id="flow_bottom2_to_top0" type="car" route="bottom2_to_top0" begin="0" end="900" vehsPerHour="500" />
    <flow id="flow_top2_to_bottom2" type="car" route="top2_to_bottom2" begin="0" end="900" vehsPerHour="400" />

    <!-- Heavy turning traffic -->
    <flow id="flow_top0_to_left" type="car" route="top0_to_left" begin="0" end="900" vehsPerHour="300" />
    <flow id="flow_top0_to_bottom" type="car" route="top0_to_bottom" begin="0" end="900" vehsPerHour="300" />
    <flow id="flow_bottom0_to_left" type="car" route="bottom0_to_left" begin="0" end="900" vehsPerHour="300" />
    <flow id="flow_bottom0_to_top" type="car" route="bottom0_to_top" begin="0" end="900" vehsPerHour="300" />
    <flow id="flow_top1_to_left" type="car" route="top1_to_left" begin="0" end="900" vehsPerHour="300" />
    <flow id="flow_bottom1_to_right" type="car" route="bottom1_to_right" begin="0" end="900" vehsPerHour="300" />
    <flow id="flow_top2_to_right" type="car" route="top2_to_right" begin="0" end="900" vehsPerHour="300" />
    <flow id="flow_bottom2_to_left" type="car" route="bottom2_to_left" begin="0" end="900" vehsPerHour="300" />
</routes>
